TELEGRAM_BOT_TOKEN=replace_me
# Comma-separated Telegram user IDs allowed to use commands.
ALLOWED_USER_IDS=123456789
# Optional comma-separated chat IDs; if empty, all chats are allowed.
ALLOWED_CHAT_IDS=
# File with targets (hosts/IP/CIDR), one per line.
TARGETS_FILE=targets.txt
DB_PATH=stats.sqlite3
POLL_INTERVAL_SECONDS=5
TIMEZONE=UTC
# Maximum number of IPs expanded from one CIDR entry.
MAX_CIDR_HOSTS=1024
# Network timeout for Minecraft ping.
PING_TIMEOUT_SECONDS=1.8
# Parallel ping workers.
MAX_CONCURRENCY=50
